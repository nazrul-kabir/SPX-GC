{
  "name": "spx-gc",
  "version": "1.3.3",
  "description": "SPX | Skaarhoj Broadcast an open-source, web-based, cross-platform, professional-grade, live-production graphics controller for an unlimited number of rundowns, templates and layers.",
  "homepage": "https://spx.graphics",
  "main": "server.js",
  "bin": "server.js",
  "pkg": {
    "assets": [
      "views/**/*",
      "static/**/*"
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon",
    "dev-debug": "set DEBUG=express:* & nodemon server.js --",
    "start": "pm2 start server.js --name SPX-GC",
    "stop": "pm2 stop SPX-GC",
    "build": "pkg . --out-path dist/ --targets node18-win-x64,node18-linux-x64,node18-macos-x64"
  },
  "keywords": [],
  "author": "Tuomo Kulomaa <tuomo@smartpx.fi> (https://spx.graphics)",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.8",
    "body-parser": "^1.20.2",
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-handlebars": "^7.1.2",
    "express-session": "^1.17.3",
    "glob": "^8.1.0",
    "ip": "^1.1.8",
    "jsdom": "^21.1.1",
    "macaddress": "^0.5.3",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "node-wav-player": "^1.0.0",
    "node-xlsx": "^0.21.0",
    "open": "^9.1.0",
    "openurl": "^1.1.1",
    "osc": "^2.4.4",
    "path": "^0.12.7",
    "ping": "^0.4.4",
    "rotating-file-stream": "^3.1.0",
    "socket.io": "^4.6.1",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "puppeteer": "^24.23.0"
  }
}
